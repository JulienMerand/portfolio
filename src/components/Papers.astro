---
import { siteConfig } from "../config";
import { getPapersWithCitations } from "../utils/citations";

const papers = await getPapersWithCitations();
const hasPapers = papers && papers.length > 0;

// Helper to highlight Julien Mérand in the author string
function formatAuthors(authors: string) {
  const parts = authors.split(/(Julien M[ée]rand)/gi);
  return parts;
}
---

{
  hasPapers && (
    <section id="papers" class="py-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto" style={`--accent: ${siteConfig.accentColor}`}>
      <!-- Section Heading -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 pb-4 border-b border-slate-200/80 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--accent)]">
            Research
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mt-1">
            Publications
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 max-w-md">
          Peer-reviewed publications in top-tier computer vision and robotics venues.
        </p>
      </div>

      <!-- Papers Stack -->
      <div class="space-y-6">
        {papers.map((pub) => {
          const authorParts = formatAuthors(pub.authors);
          
          return (
            <article class="glass-card rounded-2xl p-6 sm:p-8 shadow-xs hover:shadow-md transition-all duration-300 group border border-slate-200/80">
              <div class="flex flex-col gap-4">
                <!-- Top metadata: Conference badge & Year -->
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-lg bg-[var(--accent)] text-white shadow-2xs">
                      {pub.conferenceSurname || pub.year}
                    </span>
                    <span class="text-xs font-medium text-slate-500">
                      {pub.conference}
                    </span>
                    {pub.citations !== undefined && pub.citations > 0 && (
                      <span class="px-2.5 py-0.5 text-xs font-medium rounded-md bg-slate-100 text-slate-700 border border-slate-200/60">
                        {pub.citations} {pub.citations === 1 ? " citation" : " citations"}
                      </span>
                    )}
                  </div>

                  {pub.link && (
                    <a
                      href={pub.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 text-slate-800 hover:bg-[var(--accent)] hover:text-white transition-all shadow-2xs"
                    >
                      <span>{pub.link.includes("arxiv") ? "arXiv Paper" : "Project Page"}</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  )}
                </div>

                <!-- Paper Title -->
                <h3 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug group-hover:text-[var(--accent)] transition-colors">
                  {pub.link ? (
                    <a href={pub.link} target="_blank" rel="noopener noreferrer" class="hover:underline">
                      {pub.title}
                    </a>
                  ) : (
                    pub.title
                  )}
                </h3>

                <!-- Authors with highlight for Julien Mérand -->
                <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
                  {authorParts.map((part) => 
                    /Julien M[ée]rand/i.test(part) ? (
                      <strong class="font-bold text-slate-950 underline decoration-[var(--accent)] decoration-2 underline-offset-2">
                        {part}
                      </strong>
                    ) : (
                      <span>{part}</span>
                    )
                  )}
                </p>

                <!-- Abstract -->
                {pub.abstract && (
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed bg-slate-50/70 p-4 rounded-xl border border-slate-100">
                    {pub.abstract}
                  </p>
                )}

                <!-- Research tags -->
                {pub.tags && pub.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {pub.tags.map((tag) => (
                      <span class="px-2.5 py-1 bg-slate-100 text-slate-600 rounded-md text-[11px] font-medium border border-slate-200/50">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )
}