---
import { siteConfig } from "../config";

// Categorize skills intelligently for better visual grouping
const aiSkills = ["PyTorch", "Deep Learning", "Generative AI", "Computer Vision", "Point Cloud Processing"];
const roboticsSkills = ["Dexterous Manipulation", "ROS/ROS2", "Robots Programming", "Embedded Systems"];
const engineeringSkills = ["Python", "C/C++", "Linux", "Git"];
---

<section id="about" class="py-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto" style={`--accent: ${siteConfig.accentColor}`}>
  <!-- Section Heading -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 pb-4 border-b border-slate-200/80 gap-4">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--accent)]">
        Overview
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mt-1">
        About Me
      </h2>
    </div>
    <p class="text-xs sm:text-sm text-slate-600 max-w-md">
      Bridging artificial intelligence with embodied physical robotics.
    </p>
  </div>

  <!-- Bento Grid Container -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Main Bio Card (8 cols) -->
    <div class="lg:col-span-8 glass-card rounded-2xl p-6 sm:p-8 space-y-6 shadow-xs flex flex-col justify-between">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--accent)] bg-[var(--accent)]/10 px-3 py-1 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          Research & Background
        </div>
        <p class="text-base sm:text-lg leading-relaxed text-slate-700">
          {siteConfig.aboutMe}
        </p>
      </div>

      <!-- Quick highlight quote / tagline -->
      <div class="pt-4 border-t border-slate-100 flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-600">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
        <span>Theoretical foundations + hands-on robotics engineering commitment.</span>
      </div>
    </div>

    <!-- Personal & Lifestyle Card (4 cols) -->
    <div class="lg:col-span-4 glass-card rounded-2xl p-6 sm:p-7 space-y-6 shadow-xs flex flex-col justify-between">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-slate-700 bg-slate-100 px-3 py-1 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          Beyond Research
        </div>
        <h3 class="text-lg font-bold text-slate-900">Passions & Interests</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-normal">
          Disciplined mindset shaped by competitive athletics and musical creativity:
        </p>
        <div class="flex flex-col gap-2 pt-1">
          <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-medium text-slate-800">
            <span class="text-base">🥋</span>
            <span>Black-Belt Judoka</span>
          </div>
          <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-medium text-slate-800">
            <span class="text-base">🏃</span>
            <span>Endurance Runner & Cyclist 🚴</span>
          </div>
          <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-medium text-slate-800">
            <span class="text-base">🎸</span>
            <span>Guitarist & Audio Enthusiast</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skills & Tooling Card (Full width 12 cols) -->
    <div class="lg:col-span-12 glass-card rounded-2xl p-6 sm:p-8 space-y-6 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-100">
        <h3 class="text-lg font-bold text-slate-900">Technical Expertise & Tooling</h3>
        <span class="text-xs text-slate-500 font-mono">Specialized in AI-Driven Robotics</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- AI & ML -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--accent)] flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a4 4 0 0 1 4 4c0 1.95-1.4 3.58-3.25 3.93L13 14h-2l.25-4.07C9.4 9.58 8 7.95 8 6a4 4 0 0 1 4-4Z"></path>
            </svg>
            AI & Deep Learning
          </h4>
          <div class="flex flex-wrap gap-2">
            {
              aiSkills.map((skill) => (
                <span class="px-3 py-1.5 bg-slate-100/90 text-slate-800 rounded-lg text-xs font-medium border border-slate-200/60 hover:border-[var(--accent)]/40 hover:bg-white transition-all">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Robotics & Systems -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--accent)] flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Robotics & Manipulation
          </h4>
          <div class="flex flex-wrap gap-2">
            {
              roboticsSkills.map((skill) => (
                <span class="px-3 py-1.5 bg-slate-100/90 text-slate-800 rounded-lg text-xs font-medium border border-slate-200/60 hover:border-[var(--accent)]/40 hover:bg-white transition-all">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Core Engineering & Tools -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--accent)] flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            Engineering & Core
          </h4>
          <div class="flex flex-wrap gap-2">
            {
              engineeringSkills.map((skill) => (
                <span class="px-3 py-1.5 bg-slate-100/90 text-slate-800 rounded-lg text-xs font-medium border border-slate-200/60 hover:border-[var(--accent)]/40 hover:bg-white transition-all">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

