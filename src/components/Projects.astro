---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="py-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto" style={`--accent: ${siteConfig.accentColor}`}>
      <!-- Section Heading -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 pb-4 border-b border-slate-200/80 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--accent)]">
            Engineering & Prototypes
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mt-1">
            Projects
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 max-w-md">
          Open-source robotics, hardware prototypes, and embedded systems.
        </p>
      </div>

      <!-- 2-Column Responsive Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {siteConfig.projects.map((project, index) => {
          const isLinked = !!project.link;
          const Component = isLinked ? "a" : "div";
          const linkProps = isLinked
            ? {
                href: project.link,
                target: "_blank",
                rel: "noopener noreferrer",
              }
            : {};

          return (
            <Component
              {...linkProps}
              class={`glass-card rounded-2xl p-6 sm:p-7 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between group border border-slate-200/80 ${
                isLinked ? "hover:-translate-y-1 hover:border-[var(--accent)]/50" : ""
              }`}
            >
              <div class="space-y-4">
                <!-- Top metadata: Number & External Link Icon -->
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-[var(--accent)] bg-[var(--accent)]/10 px-2.5 py-1 rounded-md">
                    0{index + 1}
                  </span>
                  
                  {isLinked && (
                    <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 group-hover:bg-[var(--accent)] group-hover:text-white transition-all shadow-2xs">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                      </svg>
                    </div>
                  )}
                </div>

                <!-- Title -->
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-[var(--accent)] transition-colors leading-snug">
                  {project.name}
                </h3>

                <!-- Description -->
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {project.description}
                </p>
              </div>

              <!-- Skills tags at bottom -->
              {project.skills && project.skills.length > 0 && (
                <div class="flex flex-wrap gap-1.5 pt-6 mt-4 border-t border-slate-100">
                  {project.skills.map((skill) => (
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md text-[11px] font-medium border border-slate-200/50">
                      {skill}
                    </span>
                  ))}
                </div>
              )}
            </Component>
          );
        })}
      </div>
    </section>
  )
}

