---
import { siteConfig } from "../config";
import { getPapersWithCitations } from "../utils/citations";

const livePapers = await getPapersWithCitations();
const totalCitations = livePapers.reduce(
  (acc, p) => acc + (p.citations || 0),
  0,
);
const paperCount = livePapers.length || (siteConfig.papers?.length ?? 0);

// Dynamically extract unique conference acronyms/names
const conferenceList = Array.from(
  new Set(
    livePapers
      .map((p) =>
        p.conferenceSurname
          ? p.conferenceSurname.replace(/\s*\d{4}/g, "").trim()
          : p.conference.split(/[(,]/)[0]?.trim() || p.conference,
      )
      .filter(Boolean),
  ),
).join(" • ");
---

<div
  id="hero"
  class="relative isolate overflow-hidden min-h-[90vh] md:min-h-screen flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 lg:px-8 bg-grid-subtle"
  style={`--accent: ${siteConfig.accentColor}`}
>
  <!-- Ambient background glow elements -->
  <div
    class="absolute top-1/4 -left-20 w-96 h-96 rounded-full bg-[var(--accent)]/10 blur-3xl -z-10 animate-pulse-glow"
  >
  </div>
  <div
    class="absolute bottom-10 right-0 w-80 h-80 rounded-full bg-[var(--accent)]/10 blur-3xl -z-10 animate-pulse-glow"
    style="animation-delay: 2s;"
  >
  </div>

  <!-- Radial gradient overlay -->
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,rgba(13,96,148,0.08),transparent_60%)]"
  >
  </div>

  <div
    class="max-w-6xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center"
  >
    <!-- Left Column: Bio & Hero Info -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Status Badge -->
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium bg-slate-100/90 border border-slate-200/80 text-slate-800 shadow-2xs"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
          ></span>
        </span>
        <span>PhD Researcher @ CEA-List & Université Paris-Saclay</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-2">
        <p
          class="text-base sm:text-lg font-medium text-slate-500 tracking-tight"
        >
          Hello, my name is
        </p>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-slate-900 leading-tight"
        >
          <span
            class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-700 bg-clip-text text-transparent"
          >
            {siteConfig.name}
          </span>
        </h1>
        <h2
          class="text-xl sm:text-2xl md:text-3xl font-semibold text-[var(--accent)] pt-1"
        >
          {siteConfig.title}
        </h2>
      </div>

      <!-- Summary snippet -->
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
        Bridging the gap between high-level AI reasoning and low-level robotic
        control for human-like grasping and dexterous multi-fingered
        manipulation.
      </p>

      <!-- Action CTAs -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        {
          siteConfig.papers && siteConfig.papers.length > 0 && (
            <a
              href="#papers"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold text-white bg-[var(--accent)] hover:brightness-110 shadow-sm hover:shadow-md transition-all duration-200"
            >
              <span>Explore Publications</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          )
        }

        {
          siteConfig.projects && siteConfig.projects.length > 0 && (
            <a
              href="#projects"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 shadow-2xs hover:shadow-xs transition-all duration-200"
            >
              <span>Projects & Demos</span>
            </a>
          )
        }

        {
          siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 shadow-2xs hover:shadow-xs transition-all duration-200"
            >
              <span>Contact Me</span>
            </a>
          )
        }
      </div>

      <!-- Social Links Bar -->
      <div class="flex items-center gap-3 pt-4 border-t border-slate-200/60">
        <span
          class="text-xs font-semibold uppercase tracking-wider text-slate-400 mr-1"
        >
          Connect:
        </span>
        {
          siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              aria-label="Email"
              class="w-9 h-9 rounded-lg glass-card flex items-center justify-center text-slate-600 hover:text-[var(--accent)] hover:border-[var(--accent)]/50 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                <path d="M3 7l9 6l9 -6" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social?.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="w-9 h-9 rounded-lg glass-card flex items-center justify-center text-slate-600 hover:text-[var(--accent)] hover:border-[var(--accent)]/50 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M8 11v5" />
                <path d="M8 8v.01" />
                <path d="M12 16v-5" />
                <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social?.github && (
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="w-9 h-9 rounded-lg glass-card flex items-center justify-center text-slate-600 hover:text-[var(--accent)] hover:border-[var(--accent)]/50 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <!-- Right Column: Interactive Research & Stats Card -->
    <div class="lg:col-span-5">
      <div class="relative">
        <!-- Glow behind card -->
        <div
          class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-[var(--accent)]/20 to-sky-400/20 blur-xl -z-10"
        >
        </div>

        <div
          class="glass-card rounded-2xl p-6 sm:p-7 space-y-6 shadow-lg border border-slate-200/80"
        >
          <!-- Card Header -->
          <div
            class="flex items-center justify-between pb-4 border-b border-slate-100"
          >
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 rounded-xl flex items-center justify-center bg-[var(--accent)]/10 text-[var(--accent)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v5"></path>
                  <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path>
                  <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path>
                  <path
                    d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-slate-800">Research Focus</h3>
                <p class="text-xs text-slate-500">
                  Dexterous Robotic Manipulation
                </p>
              </div>
            </div>
            <span
              class="px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider rounded-md bg-[var(--accent)]/10 text-[var(--accent)]"
            >
              AI & Robotics
            </span>
          </div>

          <!-- Highlight Metric Grid -->
          <div class="grid grid-cols-2 gap-3">
            <div
              class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1"
            >
              <div class="text-2xl font-bold text-slate-800">{paperCount}</div>
              <div class="text-xs text-slate-600 font-medium">
                Conference Papers
              </div>
              {
                conferenceList && (
                  <div class="text-[10px] text-slate-600">{conferenceList}</div>
                )
              }
            </div>
            <div
              class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1"
            >
              <div class="text-2xl font-bold text-slate-800">
                {totalCitations}
              </div>
              <div class="text-xs text-slate-600 font-medium">Citations</div>
              <!-- <div class="text-[10px] text-slate-600">
                Semantic Scholar & Indices
              </div> -->
            </div>
          </div>

          <!-- Core Research Areas -->
          <div class="space-y-2.5">
            <div
              class="text-xs font-semibold uppercase tracking-wider text-slate-600"
            >
              Core Methodologies
            </div>
            <div class="flex flex-wrap gap-1.5">
              <span
                class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 text-slate-700"
              >
                Grasp Synthesis
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 text-slate-700"
              >
                Diffusion & CVAE
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 text-slate-700"
              >
                3D Point Clouds
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 text-slate-700"
              >
                ROS2
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 text-slate-700"
              >
                Robot Controls
              </span>
            </div>
          </div>

          <!-- Affiliation logos bar -->
          <div
            class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500"
          >
            <span>CEA-List</span>
            <span>•</span>
            <span>Université Paris-Saclay</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
