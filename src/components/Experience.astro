---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="py-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto" style={`--accent: ${siteConfig.accentColor}`}>
      <!-- Section Heading -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 pb-4 border-b border-slate-200/80 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--accent)]">
            Professional
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mt-1">
            Experience
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 max-w-md">
          Research and engineering roles in industry and research institutions.
        </p>
      </div>

      <!-- Timeline Container -->
      <div class="relative pl-6 sm:pl-8 ml-2 sm:ml-4 border-l-2 border-slate-200/80 space-y-10">
        {siteConfig.experience.map((exp, index) => (
          <div class="relative group">
            <!-- Timeline Node Indicator -->
            <div
              class="absolute -left-[31px] sm:-left-[39px] top-4 w-4 h-4 rounded-full bg-white border-4 border-slate-300 group-hover:border-[var(--accent)] group-hover:scale-125 transition-all shadow-xs"
              style={index === 0 ? `border-color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}` : ""}
            />

            <!-- Experience Card -->
            <div class="glass-card rounded-2xl p-6 sm:p-7 shadow-xs hover:shadow-md transition-all">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                <!-- Logo and Titles -->
                <div class="flex items-center gap-4">
                  {exp.image && (
                    <div class="w-14 h-14 rounded-xl bg-white border border-slate-200/80 p-2 flex items-center justify-center shrink-0 shadow-2xs">
                      <img
                        src={exp.image}
                        alt={`${exp.company} logo`}
                        class="max-h-full max-w-full object-contain"
                      />
                    </div>
                  )}
                  <div>
                    <h3 class="text-lg sm:text-xl font-bold text-slate-900">
                      {exp.title}
                    </h3>
                    <div class="text-sm font-semibold text-[var(--accent)] flex items-center gap-2">
                      <span>{exp.company}</span>
                      {index === 0 && (
                        <span class="px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-emerald-100 text-emerald-700">
                          Current
                        </span>
                      )}
                    </div>
                  </div>
                </div>

                <!-- Date Range Pill -->
                <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-600 bg-slate-100/80 border border-slate-200/60 self-start md:self-auto">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span>{exp.dateRange}</span>
                </div>
              </div>

              <!-- Bullets -->
              <ul class="space-y-2.5 pt-4">
                {exp.bullets.map((bullet) => (
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] mt-2 shrink-0"></div>
                    <span class="text-sm sm:text-base text-slate-700 leading-relaxed">
                      {bullet}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

